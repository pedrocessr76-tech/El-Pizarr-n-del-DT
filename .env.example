# === Base de datos del juego (PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=pizarron
DB_PASSWORD=pizarron
DB_NAME=pizarron_dt
DB_SSL=false

# synchronize=true crea/actualiza el esquema automáticamente (sólo desarrollo).
# En producción usar DB_SYNCHRONIZE=false + DB_MIGRATIONS=true.
DB_SYNCHRONIZE=true
DB_MIGRATIONS=false

# === Base de datos B2B Sistema Canchas (PostgreSQL independiente) ===
B2B_DB_HOST=localhost
B2B_DB_PORT=5433
B2B_DB_USER=canchas
B2B_DB_PASSWORD=canchas
B2B_DB_NAME=sistema_canchas
B2B_DB_SSL=false
B2B_DB_SYNCHRONIZE=false
B2B_DB_MIGRATIONS=true

# === Caché de resultados TypeORM (opcional) ===
# Para usarla, configurar Redis (en Docker: redis://redis-cache:6379;
# fuera de Docker: redis://localhost:6379) y activar cada área por separado.
# Sin URL o con flags false, las lecturas usan PostgreSQL directamente.
RESULT_CACHE_REDIS_URL=redis://localhost:6379
DB_CACHE_ENABLED=false
B2B_DB_CACHE_ENABLED=false
DB_CACHE_TTL_MS=60000
B2B_DB_CACHE_TTL_MS=60000

# === JWT Secrets (OBLIGATORIOS, mínimo 32 caracteres) ===
# El servidor se NIEGA a iniciar si faltan o son más cortos que 32 caracteres
# (auth.module / estrategias / gateways hacen throw al arrancar).
# Generá pares nuevos y distintos con:
#   openssl rand -hex 32
# JWT_SECRET=31e0f7cbb6f3f0d5d4f86e4b8cf7309d9f55535a6391e4b2a9d5f06c5e1c7a1a
# B2B_JWT_SECRET=9c2a4f7d1b8e3a5c6f9d2e4a9b1c3d5e7f8a0b6c4d2e8f1a3b5c7d9e0f2a4b6c

# === Seed B2B (SOLO desarrollo) ===
# En producción se ignora aunque este en true (NODE_ENV=production desactiva el
# seed en apps/server/src/b2b/b2b-seed.service.ts). El alta inicial de propietario
# se hace por POST /api/v1/auth/onboarding.
B2B_SEED=true
B2B_SEED_EMAIL=admin@lacancha.com.ar
B2B_SEED_PASSWORD=canchas-demo
B2B_SEED_CLIENT_EMAIL=cliente@lacancha.com.ar
B2B_SEED_CLIENT_PASSWORD=canchas-client

# === CORS ===
# En desarrollo: solo el dev-server de Vite.
# En producción (Render): agregar el dominio del frontend separado por coma.
# Sin esta variable en producción NINGUN origen cross-origin es permitido, lo
# que bloquea el refresh de sesión con 401 (el CsrfRefreshGuard valida Origin).
# Ejemplo: CORS_ORIGIN=https://el-pizarron.onrender.com,https://mi-dominio.com
CORS_ORIGIN=http://localhost:5173

# === Server ===
PORT=3001
NODE_ENV=development

# === External ===
GOOGLE_CLOUD_PROJECT=el-pizarron-del-dt
RENDER_API_KEY=

# === Mensajería multicanal (#34) ===
# Los recordatorios de #34 viajan por dos canales con tiempos de reacción
# distintos: el email lo manda el servidor solo, el aviso de WhatsApp lo
# despacha el personal desde el dashboard (no se envía desde el servidor: no hay
# proveedor gratuito y una sesión no oficial se expone a baneo).
#
# Proveedor por canal: 'smtp' | 'log'. Si no se declara, o si le falta la
# configuración completa, el canal cae a 'log' (registra el envío y lo marca
# como simulado) para no romper el arranque.
MESSAGING_PROVIDER_EMAIL=log
MESSAGING_PROVIDER_WHATSAPP=log

# === SMTP (recordatorios de email, #34) ===
# Cualquier mailbox con SMTP: el del dominio del complejo, o uno gratuito de
# pruebas. Sin SMTP_HOST el canal de email queda en modo simulado y el dashboard
# lo advierte.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Remitente. Si se omite, se usa SMTP_USER. Según el proveedor puede exigir ser
# una dirección del mismo dominio que SMTP_HOST.
SMTP_FROM=
SMTP_FROM_NAME=Sistema Canchas
# Credenciales. Gmail exige "contraseña de aplicación", no la clave de la cuenta.
SMTP_USER=
SMTP_PASSWORD=
